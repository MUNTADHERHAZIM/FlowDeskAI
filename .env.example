# ==========================================
# FlowDesk AI - Environment Variables
# ==========================================

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-flowdesk-super-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
POSTGRES_DB=flowdesk_db
POSTGRES_USER=flowdesk_user
POSTGRES_PASSWORD=flowdesk_secret_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=FlowDesk AI
